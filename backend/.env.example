# ───────── Server ─────────
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ───────── Database (PostgreSQL) ─────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/payment_portal?schema=public"

# ───────── Receipt storage (S3-compatible, private bucket) ─────────
# UpCloud Object Storage: use the endpoint and region shown on the bucket's page.
S3_ENDPOINT=https://your-endpoint.upcloudobjects.com
S3_REGION=your_region
S3_BUCKET=your_bucket
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_FORCE_PATH_STYLE=true
S3_PREFIX=payment-proofs

# ───────── Cloudinary (legacy, only until old receipts are migrated) ─────────
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ───────── QuickBooks Online (OAuth 2.0) ─────────
# Create an app at https://developer.intuit.com and copy the keys
QBO_CLIENT_ID=your_qbo_client_id
QBO_CLIENT_SECRET=your_qbo_client_secret
QBO_ENVIRONMENT=sandbox            # "sandbox" or "production"
QBO_REDIRECT_URI=http://localhost:3000/api/auth/qbo/callback
# Sign-in is "Sign in with QuickBooks" (Intuit OpenID Connect). In the Intuit app settings, add the redirect URI above
# and enable the OpenID scope alongside Accounting. (Email/Profile are not needed: people are linked by invite link.)
# The one QuickBooks company (realm) this portal serves; sign-ins from any other company are rejected.
QBO_REALM_ID=your_company_realm_id
# Encrypts the stored QuickBooks tokens at rest (AES-256-GCM). Generate with: openssl rand -base64 32
# Optional but recommended. Losing or changing it just sends everyone back through "Sign in with QuickBooks".
TOKEN_ENCRYPTION_KEY=
# First SuperAdmin: leave SUPERADMIN_QBO_SUB empty, click "Sign in with QuickBooks" once, and copy the Intuit id the
# backend log prints ("unknown Intuit id ..."). Paste it here and restart. That Intuit login then always signs in as
# SuperAdmin (and can recover a lockout). SUPERADMIN_EMAIL is only the label of that account.
SUPERADMIN_QBO_SUB=
SUPERADMIN_EMAIL=ceo@example.com

# QBO account IDs used as "Deposit To" when receiving payment (find in QBO Chart of Accounts)
QBO_DEPOSIT_ACCOUNT_BDO=
QBO_DEPOSIT_ACCOUNT_UNIONBANK=
QBO_DEPOSIT_ACCOUNT_DIGIMA=
QBO_DEPOSIT_ACCOUNT_HAPPYMED=
QBO_DEPOSIT_ACCOUNT_CASH=          # e.g. "Cash on hand" or "Undeposited Funds"
# Expense account for bank/QR fees (e.g. "Bank Charges")
QBO_BANK_FEE_ACCOUNT_ID=

# ───────── App Access (MVP role guard) ─────────
SESSION_SECRET=replace_with_a_long_random_string
ESTIMATE_LOOKBACK_DAYS=365

# Bank/QR fee rate (%) the approval screen offers as a one-click default
DEFAULT_FEE_PERCENT=1.5
